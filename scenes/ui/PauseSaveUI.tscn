[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_save_ui.gd" id="1_pause_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_pause"]
bg_color = Color(0.95, 0.92, 0.85, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
